{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graft:schema:score:0.1.0",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "graft score",
  "description": "The recipe. Text. Git-able. Analog of a USD stage / IMF CPL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["graft", "concept", "clock", "slots"],
  "properties": {
    "graft": { "const": "0.1.0" },
    "concept": {
      "type": "string",
      "description": "UUID of the one intent. Not a file.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "duration_s"],
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    },
    "layers": {
      "type": "array",
      "items": { "enum": ["base", "copy", "grade", "legal"] },
      "default": ["base"]
    },
    "dest_default": { "type": "string", "minLength": 1 },
    "spill_threshold_s": { "type": "number", "minimum": 0, "default": 0.35 }
  },
  "$defs": {
    "role": {
      "enum": ["hook", "body", "proof", "cta", "vo", "captions", "bed", "brand"]
    },
    "span": {
      "type": "array",
      "description": "[t0, t1) on the score clock, seconds.",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0 }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "span"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "role": { "$ref": "#/$defs/role" },
        "span": { "$ref": "#/$defs/span" },
        "optional": { "type": "boolean", "default": false },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "span"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "span": { "$ref": "#/$defs/span" }
          }
        }
      }
    }
  }
}
