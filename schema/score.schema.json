{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graft:schema:score:0.2.0",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "graft score",
  "description": "The Git-tracked semantic recipe for one concept.",
  "type": "object",
  "additionalProperties": false,
  "required": ["graft", "concept", "clock", "slots", "layers"],
  "properties": {
    "graft": { "const": "0.2.0" },
    "concept": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "duration_frames"],
      "properties": {
        "rate": { "$ref": "#/$defs/rate" },
        "duration_frames": { "type": "integer", "minimum": 1 }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["base", "copy", "grade", "legal"] }
    },
    "dest_default": { "type": "string", "minLength": 1 },
    "spill_threshold_frames": { "type": "integer", "minimum": 0, "default": 11 },
    "joins": {
      "type": "array",
      "items": { "$ref": "#/$defs/join" }
    }
  },
  "$defs": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "duration"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "transition", "duration_frames"],
      "properties": {
        "left": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "right": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "transition": { "enum": ["cut", "fade"] },
        "duration_frames": { "type": "integer", "minimum": 0 }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "range"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "role": { "enum": ["hook", "body", "proof", "cta", "vo", "captions", "bed", "brand"] },
        "range": { "$ref": "#/$defs/range" },
        "optional": { "type": "boolean", "default": false },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "range"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "range": { "$ref": "#/$defs/range" }
          }
        }
      }
    }
  }
}
