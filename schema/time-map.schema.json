{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graft:schema:time-map:0.1.0",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "graft time map",
  "description": "Compile output. dest_t → slot_id for one shipped build. Regenerated on retime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["graft", "scion", "dest_id", "entries"],
  "properties": {
    "graft": { "const": "0.1.0" },
    "scion": { "type": "string", "minLength": 1 },
    "dest_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["span", "slot"],
        "properties": {
          "span": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0 },
            "description": "[t0, t1) on the dest / shipped clock, seconds."
          },
          "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
