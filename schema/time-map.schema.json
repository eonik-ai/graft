{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graft:schema:time-map:0.2.0",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "graft time map",
  "description": "Exact build artifact mapping shipped frame ranges to slots and source ranges.",
  "type": "object",
  "additionalProperties": false,
  "required": ["graft", "build", "scion", "scion_hash", "dest_id", "rate", "entries"],
  "properties": {
    "graft": { "const": "0.2.0" },
    "build": { "type": "string", "minLength": 1 },
    "scion": { "type": "string", "minLength": 1 },
    "scion_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dest_id": { "type": "string", "minLength": 1 },
    "rate": { "$ref": "#/$defs/rate" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dest", "source", "slot"],
        "properties": {
          "dest": { "$ref": "#/$defs/range" },
          "source": { "$ref": "#/$defs/timedRange" },
          "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  },
  "$defs": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "duration"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 }
      }
    },
    "timedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "range"],
      "properties": {
        "rate": { "$ref": "#/$defs/rate" },
        "range": { "$ref": "#/$defs/range" }
      }
    }
  }
}
